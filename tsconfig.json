{
  "compilerOptions": {
    // Node 22 (node:22-alpine in the Dockerfile)
    "lib": ["ES2023"],
    "target": "ES2023",
    "types": ["node"],
    // ESM, to match "type": "module" in package.json
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    // Type check only (tsc --noEmit); bun build makes dist
    "rootDir": "src",
    "outDir": "dist",
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "sst-env.d.ts"]
}
