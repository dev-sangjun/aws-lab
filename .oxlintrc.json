{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "oxc/no-async-endpoint-handlers": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["sst-env.d.ts"],
  "overrides": [
    {
      "files": ["sst.config.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ]
}
